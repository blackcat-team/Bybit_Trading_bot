# ─────────────────────────────────────────────────────────────────────────────
# Bybit Telegram Trading Bot - environment configuration template
# Copy this file to .env and replace the placeholder values with your own.
# IMPORTANT: save .env as UTF-8 without BOM.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED SETTINGS ─────────────────────────────────────────────────────────

TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
BYBIT_API_KEY=YOUR_BYBIT_API_KEY
BYBIT_API_SECRET=YOUR_BYBIT_API_SECRET

# Your personal Telegram user ID only. Do not use a group or channel ID.
# You can get it from @userinfobot.
ALLOWED_TELEGRAM_ID=YOUR_TELEGRAM_ID

# ── TRADING MODE ──────────────────────────────────────────────────────────────

# IS_DEMO=True  -> Bybit demo trading
# IS_DEMO=False -> live Bybit account
IS_DEMO=True

# ── RISK SETTINGS ─────────────────────────────────────────────────────────────

# Fixed risk per trade in USDT.
# Example: 50 means the expected loss at Stop Loss is approximately $50.
USER_RISK_USD=50

# Margin buffers used to reduce the chance of Bybit error 110007
# (insufficient available balance).
MARGIN_BUFFER_USD=1.0     # Absolute buffer in USD, deducted from available margin
MARGIN_BUFFER_PCT=0.03    # Relative buffer, 3% of position notional

# ── TOTAL OPEN RISK / HEAT ────────────────────────────────────────────────────

# MAX_TOTAL_HEAT_USDT is the combined risk-to-stop across open positions.
# 0 = disabled (default).
# Example: 200 prevents new trades when total open risk would exceed $200.
MAX_TOTAL_HEAT_USDT=0

# Action when the heat limit is exceeded:
#   reject - reject the trade immediately (fail-closed, default)
#   queue  - store the signal for up to HEAT_QUEUE_TTL_MIN minutes.
#            IMPORTANT: queued trades are not executed automatically.
#            Queue execution requires a separate worker implementation.
HEAT_ACTION=reject

# Signal lifetime in the heat queue, in minutes.
# Used only when HEAT_ACTION=queue.
HEAT_QUEUE_TTL_MIN=30

# ── SAME-DIRECTION SIGNAL POLICY ───────────────────────────────────────────────

# Behavior when a new signal arrives for a symbol that already has
# an open position or pending entry order in the same direction.
#
#   ignore         - silently discard the duplicate (default, safer)
#   add_if_allowed - allow adding exposure when SOURCE_ALLOW_ADD=1
#                    and the heat budget allows it
CONFLICT_POLICY_SAME_DIR=ignore

# Allow adding exposure to an existing position in the same direction.
# Used only with CONFLICT_POLICY_SAME_DIR=add_if_allowed.
# 0 = disabled (default)
# 1 = enabled
SOURCE_ALLOW_ADD=0

# ── SIGNAL SOURCE QUARANTINE ──────────────────────────────────────────────────

# Automatically disable a signal source after N consecutive losing trades.
# 0 = disabled (default).
# Suggested starting range: 3-5.
QUARANTINE_LOSS_STREAK=0

# Disable a source when its daily PnL in USDT falls below this threshold.
# 0 = disabled.
# Use a negative value to define the allowed daily loss.
QUARANTINE_DAILY_PNL_USDT=0

# Same rule for the weekly PnL window.
QUARANTINE_WEEKLY_PNL_USDT=0

# ── MARKET ENTRY CONFIRMATION ─────────────────────────────────────────────────

# 0 = standard behavior: one tap executes the market entry immediately
# 1 = the first tap shows a trade preview and execution requires CONFIRM
#
# Confirmation mode is recommended for live trading.
REQUIRE_MARKET_CONFIRM=0

# Number of seconds the CONFIRM action remains valid after showing the preview.
MARKET_PREVIEW_TTL_SEC=300

# ── DIAGNOSTICS ───────────────────────────────────────────────────────────────

# Log a WARNING instead of DEBUG when a Bybit API call takes longer than 0.5 s.
# 1 = enabled
# Empty or 0 = disabled (default, quieter logs)
BYBIT_SLOW_CALL_WARN=

# ── OPTIONAL SCHEDULED REPORT DESTINATION ─────────────────────────────────────

# Destination for automatic Daily/Weekly Telegram reports.
# owner  = bot owner's private chat (default)
# custom = TELEGRAM_REPORT_CHAT_ID and optional topic below
TELEGRAM_REPORT_DESTINATION=owner

# Required only when TELEGRAM_REPORT_DESTINATION=custom.
TELEGRAM_REPORT_CHAT_ID=

# Optional Telegram forum topic/thread ID for the custom report destination.
TELEGRAM_REPORT_THREAD_ID=